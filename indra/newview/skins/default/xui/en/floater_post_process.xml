<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 height="400"
 layout="topleft"
 name="Post-Process Floater"
 help_topic="post_process_floater"
 title="Post-process Settings"
 width="400">
    <tab_container
     follows="left|top"
     height="400"
     layout="topleft"
     left="0"
     name="Post-Process Tabs"
     tab_position="top"
     top="0"
     width="400">
        <panel
         border="true"
         follows="left|top|right|bottom"
         height="400"
         label="Color Filter"
         layout="topleft"
         left="1"
         mouse_opaque="false"
         help_topic="post_process_color_filter_tab"
         name="ColorFilterPanel"
         top="0"
         width="398">
            <check_box
             control_name="ColorFilterToggle"
             height="16"
             label="Enable"
             layout="topleft"
             left="14"
             name="ColorFilterToggle"
             top="4"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="ColorFilterBrightnessText"
             top_pad="4"
             width="355">
                Brightness
            </text>
            <slider
             control_name="ColorFilterBrightness"
             decimal_digits="2"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.0"
             layout="topleft"
             left_delta="4"
             max_val="4"
             name="ColorFilterBrightness"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="ColorFilterSaturationText"
             top_pad="4"
             width="355">
                Saturation
            </text>
            <slider
             control_name="ColorFilterSaturation"
             decimal_digits="2"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.0"
             layout="topleft"
             left_delta="4"
             max_val="2"
             min_val="-1"
             name="ColorFilterSaturation"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="ColorFilterContrastText"
             top_pad="4"
             width="355">
                Contrast
            </text>
            <slider
             control_name="ColorFilterContrast"
             decimal_digits="2"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.0"
             layout="topleft"
             left_delta="4"
             max_val="4"
             name="ColorFilterContrast"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="ColorFilterBaseText"
             top_pad="4"
             width="355">
                Contrast Base Color
            </text>
            <slider
             control_name="ColorFilterBaseR"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.0"
             label="R"
             layout="topleft"
             left_delta="4"
             name="ColorFilterBaseR"
             top_pad="20"
             width="200" />
            <slider
             control_name="ColorFilterBaseG"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.0"
             label="G"
             layout="topleft"
             left_delta="0"
             name="ColorFilterBaseG"
             top_pad="10"
             width="200" />
            <slider
             control_name="ColorFilterBaseB"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.0"
             label="B"
             layout="topleft"
             left_delta="0"
             name="ColorFilterBaseB"
             top_pad="10"
             width="200" />
            <slider
             control_name="ColorFilterBaseI"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="0.5"
             label="I"
             layout="topleft"
             left_delta="0"
             name="ColorFilterBaseI"
             top_pad="10"
             width="200" />
        </panel>
        <panel
         border="true"
         follows="left|top|right|bottom"
         height="400"
         label="Night Vision"
         layout="topleft"
         left_delta="0"
         mouse_opaque="false"
         help_topic="post_process_night_vision_tab"
         name="NightVisionPanel"
         top_delta="-236"
         width="398">
            <check_box
             control_name="NightVisionToggle"
             height="16"
             label="Enable"
             layout="topleft"
             left="14"
             name="NightVisionToggle"
             top="4"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="NightVisionBrightMultText"
             top_pad="5"
             width="355">
                Light Amplification Multiple
            </text>
            <slider
             control_name="NightVisionBrightMult"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="3.0"
             layout="topleft"
             left_delta="4"
             max_val="10"
             min_val="1"
             name="NightVisionBrightMult"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="NightVisionNoiseSizeText"
             top_pad="4"
             width="355">
                Noise Size
            </text>
            <slider
             control_name="NightVisionNoiseSize"
             follows="left"
             height="10"
             initial_value="1"
             layout="topleft"
             left_delta="4"
             max_val="100"
             min_val="1"
             name="NightVisionNoiseSize"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="NightVisionNoiseStrengthText"
             top_pad="4"
             width="355">
                Noise Strength
            </text>
            <slider
             control_name="NightVisionNoiseStrength"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="0.3"
             layout="topleft"
             left_delta="4"
             name="NightVisionNoiseStrength"
             top_pad="20"
             width="200" />
        </panel>
        <panel
         border="true"
         follows="left|top|right|bottom"
         height="400"
         label="Bloom"
         layout="topleft"
         left_delta="0"
         help_topic="post_process_bloom_tab"
         name="BloomPanel"
         top_delta="-236"
         width="398">
            <check_box
             control_name="BloomToggle"
             height="16"
             label="Enable"
             layout="topleft"
             left="14"
             name="BloomToggle"
             top="4"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="BloomExtractText"
             top_pad="5"
             width="355">
                Luminosity Extraction
            </text>
            <slider
             control_name="BloomExtract"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="0.9"
             layout="topleft"
             left_delta="4"
             name="BloomExtract"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="BloomSizeText"
             top_pad="4"
             width="355">
                Bloom Size
            </text>
            <slider
             control_name="BloomSize"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="3.0"
             layout="topleft"
             left_delta="4"
             max_val="20"
             name="BloomSize"
             top_pad="20"
             width="200" />
            <text
             type="string"
             length="1"
             follows="left|top|right"
             font="SansSerif"
             height="16"
             layout="topleft"
             left_delta="-4"
             name="BloomStrengthText"
             top_pad="4"
             width="355">
                Bloom Strength
            </text>
            <slider
             control_name="BloomStrength"
             follows="left"
             height="10"
             increment="0.01"
             initial_value="1.2"
             layout="topleft"
             left_delta="4"
             max_val="10"
             name="BloomStrength"
             top_pad="20"
             width="200" />
        </panel>
        <panel
         border="true"
         follows="left|top|right|bottom"
         height="400"
         label="Extras"
         layout="topleft"
         left_delta="0"
         mouse_opaque="false"
         help_topic="post_process_extras_tab"
         name="Extras"
         top_delta="-236"
         width="398">
            <button
             height="20"
             label="LoadEffect"
             label_selected="LoadEffect"
             layout="topleft"
             left="15"
             name="PPLoadEffect"
             top="13"
             width="100" />
            <button
             height="20"
             label="SaveEffect"
             label_selected="SaveEffect"
             layout="topleft"
             left_delta="0"
             name="PPSaveEffect"
             top_pad="7"
             width="100" />
            <combo_box
             height="18"
             layout="topleft"
             left_delta="120"
             name="PPEffectsCombo"
             top="15"
             width="150" />
            <line_editor
             border_style="line"
             border_thickness="1"
             follows="left|right|bottom"
             font="SansSerif"
             height="20"
             label="Effect Name"
             layout="topleft"
             left_delta="0"
             max_length="40"
             name="PPEffectNameEditor"
             tab_group="1"
             top_pad="22"
             width="150" />
        </panel>
    </tab_container>
</floater>
