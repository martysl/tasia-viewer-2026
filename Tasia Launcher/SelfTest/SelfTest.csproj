<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TasiaViewerLauncherSelfTest</AssemblyName>
    <RootNamespace>TasiaViewerLauncher</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\LauncherSettings.cs" Link="LauncherSettings.cs" />
    <Compile Include="..\LauncherSelfTest.cs" Link="LauncherSelfTest.cs" />
  </ItemGroup>
</Project>
