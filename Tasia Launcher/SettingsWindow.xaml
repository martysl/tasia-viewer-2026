<Window x:Class="TasiaViewerLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasia Viewer — Settings" Width="600" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#182337" Foreground="#E6EEFA" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101B2B"/>
      <Setter Property="Foreground" Value="#E6EEFA"/>
      <Setter Property="BorderBrush" Value="#4B6886"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B6CCE4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Launcher settings" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="TasiaViewer.exe path" Margin="0,0,0,4"/><TextBox x:Name="ViewerPathInput"/></StackPanel>
      <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="9,18,0,0" Padding="12,4"/>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="Installed version (read from the viewer)" Margin="0,0,0,4"/><TextBox x:Name="VersionInput"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,12"><TextBlock Text="build_data.json URL" Margin="0,0,0,4"/><TextBox x:Name="BuildUrlInput"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="0,0,0,12"><TextBlock Text="files/mainifest.list URL (update file list)" Margin="0,0,0,4"/><TextBox x:Name="ManifestUrlInput"/></StackPanel>
    <StackPanel Grid.Row="5"><TextBlock Text="news.txt URL" Margin="0,0,0,4"/><TextBox x:Name="NewsUrlInput"/></StackPanel>
    <TextBlock Grid.Row="6" Text="The updater is read-only in this example. No files are downloaded or replaced."
               Foreground="#91B4D4" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Padding="19,7" Margin="0,0,9,0"/>
      <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="22,7" Background="#2C72A8" Foreground="White"/>
    </StackPanel>
  </Grid>
</Window>
